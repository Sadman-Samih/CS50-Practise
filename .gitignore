# Compiled files
*.o
*.obj
*.out
*.exe
*.a
*.so
*.dll
*.dylib

# Python generated files
__pycache__/
*.py[cod]

# Build directories
build/
bin/
dist/

# Ignore extensionless files (such as executables made by `make`)
*
!*/
!*.*
!.gitignore

# Allow important extensionless project files
!Makefile
!README
!LICENSE